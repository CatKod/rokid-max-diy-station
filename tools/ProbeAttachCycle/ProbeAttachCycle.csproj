<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProbeAttachCycle</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real application sources, so the probe measures exactly
         what the app does - not a copy of it. -->
    <Compile Include="..\..\src\RokidDiyStation.App\Spatial\DisplayConfigController.cs" Link="DisplayConfigController.cs" />
    <Compile Include="..\..\src\RokidDiyStation.App\Spatial\DisplayLocator.cs" Link="DisplayLocator.cs" />
    <Compile Include="..\..\src\RokidDiyStation.App\Spatial\VirtualDisplayLocator.cs" Link="VirtualDisplayLocator.cs" />
  </ItemGroup>

</Project>
