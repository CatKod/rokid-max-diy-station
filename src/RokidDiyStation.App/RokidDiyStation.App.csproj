<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>RokidDiyStation.App</RootNamespace>
    <AssemblyName>RokidDiyStation</AssemblyName>
    <StartupObject>RokidDiyStation.App.Program</StartupObject>
    <!-- Generate the tray icon before every build.  -->
    <PreBuildEvent>powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\generate-icon.ps1"</PreBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.0.124" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RokidDiyStation.Core\RokidDiyStation.Core.csproj" />
  </ItemGroup>

</Project>
