<Window x:Class="RokidDiyStation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rokid DiyStation — Settings"
        Height="780" Width="640"
        MinHeight="600" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- status -->
            <RowDefinition Height="Auto"/>  <!-- spatial panel -->
            <RowDefinition Height="Auto"/>  <!-- UDP settings -->
            <RowDefinition Height="Auto"/>  <!-- tracking settings -->
            <RowDefinition Height="Auto"/>  <!-- hotkeys -->
            <RowDefinition Height="Auto"/>  <!-- system -->
            <RowDefinition Height="*"/>     <!-- log -->
        </Grid.RowDefinitions>

        <!-- status -->
        <Border Grid.Row="0" Padding="10" Margin="0,0,0,12" CornerRadius="4" Background="#FF1F2937">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StatusText" Foreground="White" FontSize="14" FontWeight="SemiBold" Text="Idle"/>
                    <TextBlock x:Name="DetailText"  Foreground="#FFB0BEC5" FontSize="11" Margin="0,4,0,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PosText"     Foreground="#FF80CBC4" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0"/>
                    <TextBlock x:Name="EulText"     Foreground="#FFFFCC80" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0"/>
                    <TextBlock x:Name="PanelText"   Foreground="#FFCE93D8" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="SetAnchorBtn" Content="Set Anchor" Click="OnSetAnchorClick"
                            Padding="10,4" Margin="0,0,6,0" Background="#FF006064" Foreground="White"
                            BorderThickness="0" Cursor="Hand" ToolTip="Anchor here (Ctrl+Space)"/>
                    <Button x:Name="ResetAnchorBtn" Content="Reset" Click="OnResetAnchorClick"
                            Padding="10,4" Margin="0,0,6,0" Background="#FF37474F" Foreground="White"
                            BorderThickness="0" Cursor="Hand" ToolTip="Reset anchor (Ctrl+R)"/>
                    <Button x:Name="RecenterBtn" Content="Recenter" Click="OnRecenterClick"
                            Padding="10,4" Background="#FF455A64" Foreground="White"
                            BorderThickness="0" Cursor="Hand" ToolTip="Recenter view (Ctrl+C)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- spatial panel -->
        <GroupBox Grid.Row="1" Header="Spatial panel (Rokid Max)" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--
                    The source of the panel's content.

                    There is no longer a window picker.  The panel
                    shows a whole VIRTUAL DISPLAY - a real Windows
                    monitor that the user drags windows onto - so
                    there is nothing to choose from a list.  The
                    button opens or closes it.

                    The display's state is shown live, because the
                    single most common failure is that the driver is
                    not installed, and the user needs to know that
                    without having to open a terminal.
                -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Spatial display" VerticalAlignment="Center"
                           ToolTip="The virtual Windows monitor shown in the glasses. Drag any window onto it."/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VirtualDisplayText" Margin="8,0,8,0"
                           VerticalAlignment="Center" Foreground="#FF80CBC4"
                           Text="(checking…)"
                           ToolTip="The virtual display's state: its resolution and where it sits on the desktop."/>
                <Button Grid.Row="0" Grid.Column="2" Content="Open / close" Click="OnPinClick" Padding="12,4"
                        Background="#FF006064" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="Attach or detach the virtual display. Needs no administrator rights."/>

                <!--
                    The world-lock mode is the single most important
                    setting in the app, so it gets a row of its own and a
                    plain-language explanation rather than a number.

                    "Strict" is the default because a panel that is
                    dragged along with the head reads as a broken
                    anchor: the user turns their head to look at
                    something in the room and the screen comes with them.
                    "Comfort cone" is the classic AR "Tag-Along" used
                    for floating palettes, and it is offered for users
                    who want that behaviour.
                -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Anchoring" VerticalAlignment="Center" Margin="0,8,0,0"
                           ToolTip="How the panel behaves when you turn your head away from it."/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="8,8,0,0">
                    <RadioButton x:Name="StrictWorldLockRadio" GroupName="WorldLock" Content="Strict world-lock"
                                 Checked="OnWorldLockModeChanged" Margin="0,0,16,0"
                                 ToolTip="The panel stays exactly where you put it. Turning your head slides it across the display and then off the edge, like a screen on a wall. Ctrl+C brings it back."/>
                    <RadioButton x:Name="ComfortConeRadio" GroupName="WorldLock" Content="Comfort cone (tag-along)"
                                 Checked="OnWorldLockModeChanged"
                                 ToolTip="The classic AR behaviour: the panel is rigid inside a cone and is dragged back towards your gaze outside it. It follows your head during a turn."/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Comfort cone" VerticalAlignment="Center" Margin="0,8,0,0"
                           x:Name="ComfortConeLabel"
                           ToolTip="Inside this cone the panel is perfectly rigid. Outside it, the panel glides back towards your gaze."/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="8,8,0,0"
                            x:Name="ComfortConePanel">
                    <!--
                        The Maximum is set in code to the widest cone
                        the display can actually show, so the slider
                        can never offer a value that would clip the
                        panel while the gaze is still inside the
                        cone.  The 30 here is only a fallback for
                        design-time.
                    -->
                    <Slider x:Name="ComfortConeSlider" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Width="200"/>
                    <TextBlock x:Name="ComfortConeValueLabel" VerticalAlignment="Center" MinWidth="80" Margin="8,0,0,0"/>
                </StackPanel>

                <!--
                    The cursor's size.

                    This is applied LIVE, not only when "Save
                    settings" is pressed: the only practical way to
                    choose an arrow size is to see it.  The user moves
                    the slider and the arrow in the glasses grows or
                    shrinks immediately.

                    The range is set in code from CursorSize's limits,
                    so the slider can never offer a size that the
                    renderer would reject.
                -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cursor size" VerticalAlignment="Center" Margin="0,8,0,0"
                           ToolTip="How big the 3D mouse arrow is drawn in the glasses. Some people want a small precise pointer, others a big obvious one."/>
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="8,8,0,0">
                    <Slider x:Name="CursorScaleSlider"
                            Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True" Width="200"
                            ValueChanged="OnCursorScaleChanged"/>
                    <TextBlock x:Name="CursorScaleLabel" VerticalAlignment="Center" MinWidth="80" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- UDP settings -->
        <GroupBox Grid.Row="2" Header="Output (FreePIE UDP)" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" VerticalAlignment="Center"/>
                <TextBox  Grid.Row="0" Grid.Column="1" x:Name="HostBox"  Margin="0,0,8,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" VerticalAlignment="Center"/>
                <TextBox  Grid.Row="0" Grid.Column="3" x:Name="PortBox"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Hz" Margin="0,6,0,0" VerticalAlignment="Center"/>
                <Slider   Grid.Row="1" Grid.Column="1" x:Name="RateSlider" Minimum="30" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Smoothing" Margin="0,6,0,0" VerticalAlignment="Center"/>
                <Slider   Grid.Row="1" Grid.Column="3" x:Name="SmoothSlider" Minimum="0" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="False" Margin="0,6,0,0"/>
            </Grid>
        </GroupBox>

        <!-- tracking -->
        <GroupBox Grid.Row="3" Header="Tracking" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <!--
                    The magnetometer checkbox used to live here.  It was
                    removed rather than merely hidden, because on this
                    hardware the magnetometer correction is not a
                    trade-off the user should be offered: indoors the
                    Rokid Max reads ~108 uT (Earth is 25-65 uT) and the
                    chassis-dominated field swings with the device's
                    orientation.  Measured, a true 90-degree head turn
                    was reported as 142 degrees — 52 degrees of pure
                    error — and because the correction is projected into
                    the horizontal plane only, it damaged yaw and left
                    pitch and roll alone.  That is precisely the
                    "vertical is smooth, horizontal stutters" symptom.
                -->
                <CheckBox x:Name="RawPosBox"   Content="Emit head position (Raw X/Y/Z in metres)" IsChecked="True" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="FOV: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="FovLabel" Text="60°" VerticalAlignment="Center" MinWidth="40"/>
                    <Slider x:Name="FovSlider" Minimum="20" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Width="220" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Panel distance" VerticalAlignment="Center"
                               ToolTip="How far the pinned panel sits from your eyes. The glasses' optics focus at roughly 2-2.5 m; much closer and your eyes have to work for it."/>
                    <Slider x:Name="PanelDistanceSlider" Minimum="0.5" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="180" Margin="8,0,0,0"/>
                    <TextBlock x:Name="PanelDistanceLabel" VerticalAlignment="Center" MinWidth="60" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Neck model" VerticalAlignment="Center"
                               ToolTip="How much of the kinematic neck model's eye translation to apply. Lower = more rigid, less swimming."/>
                    <Slider x:Name="NeckScaleSlider" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="180" Margin="8,0,0,0"/>
                    <TextBlock x:Name="NeckScaleLabel" VerticalAlignment="Center" MinWidth="60" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- hotkeys -->
        <GroupBox Grid.Row="4" Header="Hotkeys" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Set anchor here" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Ctrl+Shift+Win+Alt+Space" Foreground="#FF64B5F6"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Reset anchor" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+Shift+Win+Alt+R" Foreground="#FF64B5F6"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Recenter view" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl+Shift+Win+Alt+C" Foreground="#FF64B5F6"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Show/hide this window" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Ctrl+Shift+Win+Alt+H" Foreground="#FF64B5F6" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Bring the mouse back" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Ctrl+Shift+Win+Alt+G" Foreground="#FF64B5F6" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="" VerticalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="If a combination is already taken by another app, an alternate is used and the log says which one." Foreground="#FF9E9E9E" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </Grid>
        </GroupBox>

        <!-- system -->
        <GroupBox Grid.Row="5" Header="System" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <CheckBox x:Name="AutostartBox" Content="Start with Windows (auto-launch minimised)" Margin="0,0,0,4"/>
                <CheckBox x:Name="StartMinBox"  Content="Start minimised to tray" Margin="0,0,0,4"/>
                <Button Content="Save settings" HorizontalAlignment="Left" Padding="16,4" Click="OnSaveClick"/>
            </StackPanel>
        </GroupBox>

        <!-- log -->
        <GroupBox Grid.Row="6" Header="Status log" Padding="0">
            <ListBox x:Name="LogList" Background="#FF0F172A" Foreground="#FFE0F2F1" FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
        </GroupBox>
    </Grid>
</Window>
